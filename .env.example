# ================================
# AgroConnect - Plantilla de Variables de Entorno
# ================================
# Este archivo SÍ va en Git (es la plantilla pública, sin valores reales).
# Cópialo como .env y completa los valores antes de correr el proyecto.

# Puerto del servidor Java
PORT=8080

# URL base de la API (servidor Java local)
API_BASE_URL=http://localhost:8080

# URL de la API externa
FAKE_STORE_API_URL=https://fakestoreapi.com

# Base de datos (si aplica)
# DB_URL=jdbc:mysql://localhost:3306/agroconnect
# DB_USER=root
# DB_PASSWORD=
